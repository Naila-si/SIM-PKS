# ==============================================================================
# SIM-PKS - PRODUCTION ENVIRONMENT CONFIGURATION (SEC-01 & SEC-DOC-01)
# ==============================================================================
# Salin berkas ini menjadi .env pada server hosting/production Anda:
# cp .env.production.example .env
# Jalankan: php artisan key:generate

APP_NAME="SIM-PKS Jasa Raharja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simpks.jasaraharja.co.id
FRONTEND_URL=https://simpks.jasaraharja.co.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Pengaturan Keamanan Session & Cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Database Production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_pks_prod
DB_USERNAME=sim_pks_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT

# Logging Production
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Bcrypt Cost Factor
BCRYPT_ROUNDS=12

# File Storage Keamanan Dokumen (Wajib 'local' / private storage)
# Dokumen PKS, Adendum, dan Surat Penghentian tersimpan di storage/app/private
# dan hanya dapat diunduh melalui endpoint API backend yang terautentikasi.
FILESYSTEM_DISK=local
